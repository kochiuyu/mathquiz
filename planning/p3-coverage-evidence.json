  "inquiry": [
    {
      "topic": "numbers",
      "title": "Investigate: move a digit card",
      "prompt": "Move five digit cards 0, 2, 4, 6, 8; choose what changes and stays the same.",
      "url": "../p3-learn.html?path=numbers&stage=investigate"
    },
    {
      "topic": "multiply",
      "title": "Investigate: regroup the same collection",
      "prompt": "Use 2 trays, 3 cups per tray and 5 counters per cup. Ask which grouping is easier to count and why. Predict before moving objects. Then change one quantity (keep factors small), test both routes and explain intermediate units. You may choose a different question.",
      "url": "../p3-learn.html?path=multiply&stage=investigate"
    },
    {
      "topic": "division",
      "title": "Investigate: change the grouping",
      "prompt": "Choose 24, 36 or 48 counters. Predict whether dividing first into 6 groups then splitting each in 2 gives the same amount as first finding 6 ÷ 2 and then sharing into that many groups. Keep a prediction, try both, and explain who receives each share. Extend to another total.",
      "url": "../p3-learn.html?path=division&stage=investigate"
    },
    {
      "topic": "mixed",
      "title": "Investigate: can brackets change a total?",
      "prompt": "Choose three small number cards and +, − or × cards. Predict how placing one pair of brackets could change the result, then test at least two placements. Keep nonnegative results, unsuccessful predictions and a case that stays equal. Explain each grouping with a drawing or objects. Do not nest brackets.",
      "url": "../p3-learn.html?path=mixed&stage=investigate"
    },
    {
      "topic": "fractions",
      "title": "Investigate: keep the marked amount",
      "prompt": "Use equal-sized strips. Choose a marked fraction and predict whether extra equal folds can change its counts while keeping the marked amount. Record a plan before trying. Overlay to check, include a non-matching example, explain the fixed whole and try a new fraction.",
      "url": "../p3-learn.html?path=fractions&stage=investigate"
    },
    {
      "topic": "fractionops",
      "title": "Investigate: different shares, same total",
      "prompt": "Divide a whole strip into eight equal parts. Predict which two non-overlapping shares can cover six parts altogether. Try several pairs, including zero, and explain what changes and what stays fixed. Then try three shares or a subtraction picture. Keep the original prediction and unsuccessful trials; do not mix addition and subtraction in one equation.",
      "url": "../p3-learn.html?path=fractionops&stage=investigate"
    },
    {
      "topic": "length",
      "title": "Investigate: a reference helps?",
      "prompt": "After measuring reference strips, choose a question: does using a known strip help you estimate NEW strips or dot-pair distances? Predict, plan a fair comparison, keep every first estimate, then measure with a real ruler. Change your reference or question and test again. Do not measure the screen.",
      "url": "../p3-learn.html?path=length&stage=investigate"
    },
    {
      "topic": "time",
      "title": "Investigate: how close are our time estimates?",
      "prompt": "Choose a safe seated activity. Agree start/finish actions and a tool. Save a prediction and plan before timing. Keep actual readings, display precision and any late starts; repeat fairly and explain differences without erasing your original estimate. No running, breath-holding or speed competition.",
      "url": "../p3-learn.html?path=time&stage=investigate"
    },
    {
      "topic": "capacity",
      "title": "Investigate: does the taller container always hold more?",
      "prompt": "Choose two clean unbreakable containers. Record your prediction and fair comparison plan before testing with cool water over a tray. Record capacity, not just current water. Keep spills and repeat invalid trials. Try another pair and explain whether height alone decides. Adult supervision; never use hot water, glass, medicines or chemicals.",
      "url": "../p3-learn.html?path=capacity&stage=investigate"
    },
    {
      "topic": "clock24",
      "title": "Investigate: which labels prevent confusion?",
      "prompt": "Predict which timetable labels a partner will read without asking for clarification. Make paired 12/24-hour cards with dates, noon and adjacent-day midnight. Keep the prediction, record actual readings and corrections, then explain which missing labels caused confusion. Do not calculate elapsed time.",
      "url": "../p3-learn.html?path=clock24&stage=investigate"
    },
    {
      "topic": "weight",
      "title": "Investigate: is the bigger object always heavier?",
      "prompt": "Choose two safe light objects. Record your prediction and a fair balance plan before testing. Check zero, centre the objects, wait and swap sides. Keep unsuccessful or invalid trials. Try another pair and explain whether size alone decides. An adult checks tool limits; no heavy lifting, people or pets.",
      "url": "../p3-learn.html?path=weight&stage=investigate"
    },
    {
      "topic": "quads",
      "title": "Investigate: keep the parallel pairs",
      "prompt": "Predict which changes to a four-corner model will keep two parallel pairs, and which will leave exactly one. Plan before trying. Draw or make several examples, turn them, check both pairs and record a counterexample. Explain what changed and test a new construction.",
      "url": "../p3-learn.html?path=quads&stage=investigate"
    },
    {
      "topic": "triangles",
      "title": "Investigate: when can three strips close?",
      "prompt": "Keep two strip lengths fixed and predict which third lengths can form a triangle. Record your plan before trying. Test shorter, equal-sum and longer cases; keep failures, explain the boundary and try a different fixed pair. Use real strips as well as the screen model.",
      "url": "../p3-learn.html?path=triangles&stage=investigate"
    },
    {
      "topic": "bars",
      "title": "Investigate: which chart makes our data clear?",
      "prompt": "Choose a familiar anonymous collection question and categories. Predict which scale/orientation will help a partner read the results. Keep raw responses, tallies and frequencies in your trials; label simulated fallback data clearly. Make both orientations from the same data, record your partner’s actual reading and revise the presentation without changing frequencies. Keep the first prediction and any help.",
      "url": "../p3-learn.html?path=bars&stage=investigate"
    }
  ],
